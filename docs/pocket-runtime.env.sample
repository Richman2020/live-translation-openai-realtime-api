# Operator-only example. Not loaded automatically; contains no credentials.
# Both paths must point to already provisioned, audited local files.
POCKET_RUNTIME_DIR=/srv/ai-phone/pocket-runtime
POCKET_PYTHON_EXECUTABLE=/srv/ai-phone/pocket-runtime/venv/bin/python
# Omit both variables to retain the platform-specific repository venv default.
# Startup never installs dependencies or downloads missing model assets.
