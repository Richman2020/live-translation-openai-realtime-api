# Names only. Configure independently in the approved service; do not copy a
# different project's secrets. This template intentionally cannot start calls.
AI_PHONE_RUNTIME_MODE=cloud
PORT=8080
CLOUD_WARM_INSTANCES=1
CLOUD_PUBLIC_ORIGIN=
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_NUMBER=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAIL=
# A non-Gmail identity requires an independently verified Workspace hd or sub.
GOOGLE_HOSTED_DOMAIN=
GOOGLE_SUBJECT=
# Default three OpenAI sockets. Explicit true adds two outgoing caption sockets.
CLOUD_OUTGOING_PAIRED_CAPTIONS_ENABLED=false
# These are current operator attestations; placeholders are not proof.
CLOUD_TRANSLATION_CAPABILITY_CONFIRMED=false
CLOUD_PUBLIC_CALLBACK_CONFIRMED=false
CLOUD_TRIAL_RATE_BOUND_CONFIRMED=false
CLOUD_JOURNAL_VOLUME_CONFIRMED=false
# Canonical UTC ISO instants, including milliseconds; deadline <= one hour away.
CLOUD_TEST_DEADLINE=
CLOUD_RATE_CHECKED_AT=
CLOUD_RATE_VALID_UNTIL=
# One independently approved US target; do not put a real number in Git.
CLOUD_TEST_TARGET_NUMBER=
# Conservative bound in USD micros, <= 5000000, includes every selected socket.
CLOUD_CALL_RESERVATION_USD_MICROS=
# Must be on a real private persistent volume, not /tmp or ephemeral app storage.
CLOUD_JOURNAL_DIRECTORY=/data/phone-journal
