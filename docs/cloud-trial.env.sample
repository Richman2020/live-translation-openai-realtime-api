# Personal phone configuration without an application spending budget. Private values remain empty; this template
# intentionally cannot start calls. Do not copy another project's secrets.
# Web-only configuration is separate: see CLOUD_WEB_VERIFICATION.md and the
# commented minimal example below. Missing mode keeps every phone safeguard.
CLOUD_SERVICE_MODE=phone
AI_PHONE_RUNTIME_MODE=cloud
PORT=8080
CLOUD_WARM_INSTANCES=1
CLOUD_PUBLIC_ORIGIN=https://ai-phone-test-staging.up.railway.app
PUBLIC_BASE_URL=https://ai-phone-test-staging.up.railway.app
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_NUMBER=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAIL=
# A non-Gmail identity requires an independently verified Workspace hd or sub.
GOOGLE_HOSTED_DOMAIN=
GOOGLE_SUBJECT=
# Default three OpenAI sockets. Explicit true adds two outgoing caption sockets.
CLOUD_OUTGOING_PAIRED_CAPTIONS_ENABLED=false
# Callback confirmation remains; model capability is tested at handshake.
CLOUD_PUBLIC_CALLBACK_CONFIRMED=false
# One independently approved target; do not put a real number in Git.
CLOUD_TEST_TARGET_NUMBER=
# Budget/rate/reservation/journal and CLOUD_TEST_DEADLINE fields are ignored by
# personal phone mode. Do not create a journal or alter old files to start it.
# See CLOUD_PERSONAL_NO_BUDGET.md. Provider account limits remain unchanged.

# Separate minimal WEB configuration; these comments do not override phone mode.
# Configure this set independently with actual private Google values and a fresh
# UTC ISO deadline (milliseconds, future <= 1 hour), chosen by the parent task.
# A non-Gmail identity requires the expected hosted domain OR a pinned subject.
# For non-Gmail fill a verified binding; OMIT any unused optional variable.
# CLOUD_SERVICE_MODE=web-verification
# AI_PHONE_RUNTIME_MODE=cloud
# PORT=8080
# CLOUD_WARM_INSTANCES=1
# CLOUD_PUBLIC_ORIGIN=https://ai-phone-test-staging.up.railway.app
# PUBLIC_BASE_URL=https://ai-phone-test-staging.up.railway.app
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_EMAIL=
# GOOGLE_HOSTED_DOMAIN=
# GOOGLE_SUBJECT=
# CLOUD_TEST_DEADLINE=
# Web mode does not read/require OpenAI/Twilio values, target, the four CONFIRMED
# flags, rates, call-cost reservation or journal/volume settings. Do not fill
# paid-provider placeholders or mark those flags true for website verification.

# Separate DAILY WEB configuration, without a service test deadline. These
# comments do not override the default phone mode above. See CLOUD_WEB_WORKBENCH.md.
# Use actual private Google values and omit unused optional identity variables.
# CLOUD_SERVICE_MODE=web-workbench
# AI_PHONE_RUNTIME_MODE=cloud
# PORT=8080
# CLOUD_WARM_INSTANCES=1
# CLOUD_PUBLIC_ORIGIN=https://ai-phone-test-staging.up.railway.app
# PUBLIC_BASE_URL=https://ai-phone-test-staging.up.railway.app
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_EMAIL=
# GOOGLE_HOSTED_DOMAIN=
# GOOGLE_SUBJECT=
# This explicit mode ignores CLOUD_TEST_DEADLINE and all paid/provider fields.
# Page leases keep open workbenches signed in; see CLOUD_WEB_WORKBENCH.md.
# It does not authorize deployment or daily phone calls; every call/WS is denied.
