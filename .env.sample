# Twilio
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_CALLER_NUMBER=+1XXXXXXXXXX
TWILIO_FLEX_NUMBER=+1XXXXXXXXXX
TWILIO_FLEX_WORKFLOW_SID=WW00000000000000000000000000000000
# OpenAI
OPENAI_API_KEY=replace-with-api-key
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Optional solo Realtime HTTP(S) proxy origin. Leave blank for a direct connection.
# Keep proxy authentication private; do not add a path, query, or fragment.
OPENAI_PROXY_URL=
# App Config
API_PORT=5050
NODE_ENV=development
NGROK_DOMAIN=your-ngrok-subdomain.ngrok.app
FORWARD_AUDIO_BEFORE_TRANSLATION=false

# Desktop single-user mode (npm run start:solo). Flex fields above are unused.
API_HOST=127.0.0.1
PUBLIC_BASE_URL=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# Generated locally by the desktop launcher. Do not share or commit.
LOCAL_ACCESS_TOKEN=
